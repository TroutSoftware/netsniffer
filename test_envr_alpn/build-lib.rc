

_bwrap_base() {
echo "BWRAP STARTING IN: $(pwd)"
    $BWRAP_PREFIX bwrap \
        --ro-bind "$TEST_DIR_ALPN_OS" / \
        --tmpfs /home \
        --bind "$BASE_DIR" "$BASE_DIR" \
        --bind "$REDO_CACHE_ALPN_FOLDER" "$BASE_DIR"/.redo \
        --chdir "$(pwd)" \
        --tmpfs /tmp \
        --proc proc \
        --dev dev \
        --dir /run \
        --setenv TEST_ENV "$TEST_ENV" \
        --setenv TEST_ENV_DIR "$TEST_DIR_ALPN" \
        --setenv TEST_ENV_BUILD_DIR "$TEST_DIR_BUILD" \
        --setenv TEST_ENV_OS_DIR "$TEST_DIR_ALPN_OS" \
        --setenv PATH "/usr/lib/llvm21/bin:/usr/bin:/bin" \
        "$@"
}

_bwrap_base_target() {
    $BWRAP_PREFIX bwrap \
        --clearenv \
        --ro-bind "$TEST_DIR_ALPN_OS" \
        --setenv PATH "/usr/bin:/bin:$(go env GOROOT)/bin" \
        --tmpfs /tmp \
        --proc proc \
        --dev dev \
        --bind "$BASE_DIR" "$BASE_DIR" --chdir "$BASE_DIR" \
        --bind "$REDO_CACHE_ALPN_FOLDER" "$BASE_DIR"/.redo \
        --bind "$TEST_DIR_BUILD" "$BASE_DIR"/p \
        --bind "$GO_RUNTIME" /go \
        --setenv GOPROXY "https://proxy.devit.trout.software,https://proxy.golang.org" \
        --setenv GONOSUMDB "trout.software" \
        --setenv GOMODCACHE "/go/mods" \
        --setenv GOCACHE "/go/cache" \
        --setenv TEST_ENV "$TEST_ENV" \
        --setenv TEST_ENV_DIR "$TEST_DIR_ALPN" \
        --setenv TEST_ENV_BUILD_DIR "$TEST_DIR_BUILD" \
        --setenv TEST_ENV_OS_DIR "$TEST_DIR_ALPN_OS" \
        --bind "$TEST_DIR_ALPN_OS/srv" /srv \
        "$@"
}

_bwrap() {
echo "BWRAP launch parameters: $(pwd)\$ $@" >&2
    BWRAP_PREFIX="" _bwrap_base -- "$@"
}

_bwrap_old() {
    bwrap --tmpfs / \
        --clearenv \
        --setenv PATH "$PATH:$(go env GOROOT)/bin" \
        --ro-bind "$TEST_DIR_ALPN_OS/bin" /bin \
        --ro-bind "$TEST_DIR_ALPN_OS/etc" /etc \
        --ro-bind "$TEST_DIR_ALPN_OS/lib" /lib \
        --ro-bind "$TEST_DIR_ALPN_OS/sbin" /sbin \
        --bind "$TEST_DIR_ALPN_OS/usr" /usr \
        --ro-bind "$(go env GOROOT)" "$(go env GOROOT)" \
        --dir /tmp --proc proc --dev dev --dir /run \
        --bind "$BASE_DIR" "$BASE_DIR" --chdir "$BASE_DIR" \
        --bind "$REDO_CACHE_ALPN_FOLDER" "$BASE_DIR"/.redo \
        --bind "$TEST_DIR_BUILD" "$BASE_DIR"/p \
        --setenv GOPROXY "https://proxy.devit.trout.software,https://proxy.golang.org" \
        --setenv GONOSUMDB "trout.software" \
        --setenv GOMODCACHE "/go/mods" \
        --setenv GOCACHE "/go/cache" \
        --setenv TEST_ENV "$TEST_ENV" \
        --setenv TEST_ENV_DIR "$TEST_DIR_ALPN" \
        --setenv TEST_ENV_BUILD_DIR "$TEST_DIR_BUILD" \
        --setenv TEST_ENV_OS_DIR "$TEST_DIR_ALPN_OS" \
        --bind "$TEST_DIR_ALPN_OS/srv" /srv \
        -- "$@"
}

_bwrap_sudo() {
  BWRAP_PREFIX="sudo" _bwrap_base \
        --dev-bind /dev /dev \
        --cap-add CAP_NET_RAW \
        --cap-add CAP_NET_ADMIN \
        --share-net \
        -- "$@"
}

_bwrap_sudo_old() {
    sudo bwrap --tmpfs / \
        --clearenv \
        --setenv PATH "$PATH:$(go env GOROOT)/bin" \
        --ro-bind "$TEST_DIR_ALPN_OS/bin" /bin \
        --ro-bind "$TEST_DIR_ALPN_OS/etc" /etc \
        --ro-bind "$TEST_DIR_ALPN_OS/lib" /lib \
        --ro-bind "$TEST_DIR_ALPN_OS/sbin" /sbin \
        --bind "$TEST_DIR_ALPN_OS/usr" /usr \
        --ro-bind "$(go env GOROOT)" "$(go env GOROOT)" \
        --dir /tmp --proc proc --dev dev --dir /run \
        --bind "$BASE_DIR" "$BASE_DIR" --chdir "$BASE_DIR" \
        --bind "$REDO_CACHE_ALPN_FOLDER" "$BASE_DIR"/.redo \
        --bind "$TEST_DIR_BUILD" "$BASE_DIR"/p \
        --setenv GOPROXY "https://proxy.devit.trout.software,https://proxy.golang.org" \
        --setenv GONOSUMDB "trout.software" \
        --setenv GOMODCACHE "/go/mods" \
        --setenv GOCACHE "/go/cache" \
        --setenv TEST_ENV "$TEST_ENV" \
        --setenv TEST_ENV_DIR "$TEST_DIR_ALPN" \
        --setenv TEST_ENV_BUILD_DIR "$TEST_DIR_BUILD" \
        --setenv TEST_ENV_OS_DIR "$TEST_DIR_ALPN_OS" \
        --bind "$TEST_DIR_ALPN_OS/srv" /srv \
        --dev-bind /dev /dev \
        --cap-add CAP_NET_RAW \
        --cap-add CAP_NET_ADMIN \
        --share-net \
        -- "$@"
}


_build_port() {
  _bwrap --bind "$local" /usr/local \
                sh <<EOF
set -xe
/opt/go/bin/go build -o /usr/local/bin/zmod trout.software/cyberos/dist/tools/zmod
EOF
  _bwrap --bind "${src}" /ports \
                --bind "${local}" /usr/local \
                sh
}
