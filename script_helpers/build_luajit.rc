# This file builds Luajit2

# Config Luajit2, it uses make and polutes the build folder, so we take a copy

echo "Building luajit2..."
LUAJIT2_CONFIGURE_SCRIPT="$BUILD_TOOLS_FOLDER/luajit2_configure.sh"
{
#!/bin/sh
# This is an autogenerated script that builds luajit
# to modify this script edit build_luajit.rc

# Fail if anything fail
set -e

cat <<EOF
  cp -r "$SOURCE_FOLDER/luajit2" "$BASE_BUILD_FOLDER/luajit2"
EOF
  _launch_to_stdout
cat <<EOF
    sh -c 'cd "$BASE_BUILD_FOLDER/luajit2"; \\
    make clean \\
    CC="$CC"  \\
    HOST_CC="$CC" \\
    CXX="$CXX"; \\
    make \\
    CC="$CC"  \\
    HOST_CC="$CC" \\
    CXX="$CXX" \\
    CFLAGS="$CFLAGS" \\
    CXXFLAGS="$CXXFLAGS" \\
    LD_LIBRARY_PATH="$LD_LIBRARY_PATH" \\
    LDFLAGS="$LDFLAGS";'
EOF
} > "$LUAJIT2_CONFIGURE_SCRIPT"
chmod a+x $LUAJIT2_CONFIGURE_SCRIPT

"$LUAJIT2_CONFIGURE_SCRIPT" >"$LUAJIT2_CONFIGURE_SCRIPT.log" 2>&1

LUAJIT2_INSTALL_SCRIPT="$BUILD_TOOLS_FOLDER/luajit2_install.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that installs luajit
# to modify this script edit build_luajit.rc

# Fail if anything fail
set -e

EOF
  _launch_to_stdout
cat <<EOF
    sh -c 'cd "$BASE_BUILD_FOLDER/luajit2"; \\
    make install PREFIX="$INSTALL_FOLDER" \\
    CC="$CC"  \\
    HOST_CC="$CC" \\
    CXX="$CXX" \\
    CFLAGS="$CFLAGS" \\
    CXXFLAGS="$CXXFLAGS" \\
    LD_LIBRARY_PATH="$LD_LIBRARY_PATH" \\
    LDFLAGS="$LDFLAGS"'
EOF
} > "$LUAJIT2_INSTALL_SCRIPT"
chmod a+x $LUAJIT2_INSTALL_SCRIPT

echo "Building & installing luajit2..."
"$LUAJIT2_INSTALL_SCRIPT" >"$LUAJIT2_INSTALL_SCRIPT.log" 2>&1

