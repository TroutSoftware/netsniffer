

SH3_BUILD_SCRIPT="sh3_build.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that builds sh3
# to modify this script edit build_sh3.rc

# Fail if anything fail
set -e

  go -C "$SOURCE_FOLDER" build -o "$BUILD_TOOLS_FOLDER/sh3" "$SOURCE_FOLDER/sh3"
EOF
} > "$BUILD_TOOLS_FOLDER/$SH3_BUILD_SCRIPT"

chmod +x "$BUILD_TOOLS_FOLDER/$SH3_BUILD_SCRIPT"

"$BUILD_TOOLS_FOLDER/$SH3_BUILD_SCRIPT"

SH3_TEST_ALL_SCRIPT="sh3_test_all.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that runs all testcases with sh3
# to modify this script edit build_sh3.rc

# Fail if anything fail
set -e

"$BUILD_TOOLS_FOLDER/$SH3_BUILD_SCRIPT"
"$BASE_BUILD_FOLDER/$CORE_BUILD_SCRIPT"

grep -v '^#' "$SOURCE_FOLDER/sh3_tests.list" | sed s#^#$TROUT_PLUGINS/# |  xargs "$BUILD_TOOLS_FOLDER/sh3"
EOF
} > "$BASE_BUILD_FOLDER/$SH3_TEST_ALL_SCRIPT"

chmod +x "$BASE_BUILD_FOLDER/$SH3_TEST_ALL_SCRIPT"

echo "To run Trout plugin tests, run: $SH3_TEST_ALL_SCRIPT"
