# This file configures core, and create build files for it

if [ $MODE = "DEBUG" ]; then
  CORE_BUILD_MODE=Debug
else
  CORE_BUILD_MODE=Release
fi

CORE_BUILD_FOLDER=$BASE_BUILD_FOLDER/core

mkdir -p $CORE_BUILD_FOLDER

echo "Configuring core..."
CORE_CONFIGURE_SCRIPT="$BUILD_TOOLS_FOLDER/core_configure.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that configures core
# to modify this script edit configure_core.rc

# Fail if anything fail
set -e

EOF
_launch_to_stdout
cat << EOF
    sh -c '\\
    PKG_CONFIG_PATH="$INSTALL_FOLDER/lib/pkgconfig:$PKG_CONFIG_PATH" cmake \\
    -S "$SOURCE_FOLDER/core" \\
    -B "$CORE_BUILD_FOLDER" \\
    -G Ninja \\
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \\
    -DCMAKE_INSTALL_PREFIX="$INSTALL_FOLDER" \\
    -DCMAKE_BUILD_TYPE=$CORE_BUILD_MODE \\
    -DENABLE_STDLOG=ON \\
    -DENABLE_STATIC_DAQ=ON \\
    -DCMAKE_C_COMPILER="$CC" \\
    -DCMAKE_CXX_COMPILER="$CXX" \\
    -DCMAKE_CXX_FLAGS="$CXXFLAGS" \\
    -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" \\
    -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS" \\
    -DCMAKE_LINKER="$LD"'
EOF
} > $CORE_CONFIGURE_SCRIPT

chmod +x "$CORE_CONFIGURE_SCRIPT"

"$CORE_CONFIGURE_SCRIPT" >"$CORE_CONFIGURE_SCRIPT.log" 2>&1


CORE_BUILD_SCRIPT="build.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that builds core (snort)
# to modify this script edit configure_core.rc

# Fail if anything fail
set -e

EOF

_launch_to_stdout
cat << EOF
    ninja -C "$CORE_BUILD_FOLDER" \$@
EOF
} > "$BASE_BUILD_FOLDER/$CORE_BUILD_SCRIPT"

chmod +x "$BASE_BUILD_FOLDER/$CORE_BUILD_SCRIPT"



echo "To build, run: $CORE_BUILD_SCRIPT"

CORE_INSTALL_SCRIPT="install.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that installs core (snort)
# to modify this script edit configure_core.rc

# Fail if anything fail
set -e

EOF

cat << EOF
  $CORE_BUILD_SCRIPT install
EOF
} > "$BASE_BUILD_FOLDER/$CORE_INSTALL_SCRIPT"

chmod +x "$BASE_BUILD_FOLDER/$CORE_INSTALL_SCRIPT"

echo "To install, run: $CORE_INSTALL_SCRIPT"

_snort_cmd_to_stdout() {
cat << EOF
    sh -c \\
EOF
if [ $# -gt 0 ]; then
cat << EOF
    '$@; \\
EOF
else
cat << EOF
    '\\
EOF
fi
cat << EOF
    LD_LIBRARY_PATH="$INSTALL_FOLDER/lib" \\
    "$CORE_BUILD_FOLDER/src/snort" \\
    -v \\
    --warn-all \\
    --daq-dir "$INSTALL_FOLDER/lib/daq" \\
    \$@' \\
    sh "\$@"
EOF
}


SNORT_LAUNCH_SCRIPT="snort.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that launches snort
# to modify this script edit configure_core.rc

# Fail if anything fail
set -e

$BASE_BUILD_FOLDER/$CORE_BUILD_SCRIPT

EOF
_launch_to_stdout
_snort_cmd_to_stdout

} > "$BASE_BUILD_FOLDER/$SNORT_LAUNCH_SCRIPT"

chmod +x "$BASE_BUILD_FOLDER/$SNORT_LAUNCH_SCRIPT"

echo "To build and launch snort, run: $SNORT_LAUNCH_SCRIPT"


LLDB_LAUNCH_SCRIPT="lldb_snort.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that launches snort in the lldb debugger
# to modify this script edit configure_core.rc

# Fail if anything fail
set -e

$BASE_BUILD_FOLDER/$CORE_BUILD_SCRIPT

EOF
_launch_to_stdout
cat << EOF
    sh -c " \\
    LD_LIBRARY_PATH=\\"$INSTALL_FOLDER/lib\\" \\
    lldb -o \\"breakpoint set -E c++\\" \\
         -- \\"$CORE_BUILD_FOLDER/src/snort\\" \\
         -v \\
         --warn-all \\
         --daq-dir \\"$INSTALL_FOLDER/lib/daq\\" \\
         $@"
EOF
} > "$BASE_BUILD_FOLDER/$LLDB_LAUNCH_SCRIPT"

chmod +x "$BASE_BUILD_FOLDER/$LLDB_LAUNCH_SCRIPT"

echo "To build and launch lldb with snort, run: $LLDB_LAUNCH_SCRIPT"

CLANGD_LAUNCH_SCRIPT="clangd.sh"
{
cat << EOF
#!/bin/sh
# This is an autogenerated script that launches snort in the lldb debuger
# to modify this script edit configure_core.rc

# Fail if anything fail
set -e

exec \\
EOF
_launch_to_stdout
cat << EOF
    clangd "\$@" \\
      --compile-commands-dir="$CORE_BUILD_FOLDER"
EOF
} > "$BASE_BUILD_FOLDER/$CLANGD_LAUNCH_SCRIPT"

chmod +x "$BASE_BUILD_FOLDER/$CLANGD_LAUNCH_SCRIPT"

echo "clangd script for your editor(s): $CLANGD_LAUNCH_SCRIPT"
