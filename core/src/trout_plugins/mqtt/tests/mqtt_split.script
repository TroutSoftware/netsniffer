pcap testdata/mqtt_split_msg.pcap
cmp output.txt testdata/mqtt_split.expected.txt

stdout 'client_id_cache_max_size: 1'
stdout 'flow_count: 52'
stdout 'multimsg_packages: 102'
stdout 'new_ip_client_id: 1'
stdout 'messages: 156'
stdout 'protocol_3_1: 52'
stdout 'scan_count: 206'
stdout 'split_packages: 50'


-- cfg.lua --

stream = {}
stream_tcp = {}

logger_file = { file_name = 'output.txt',
                serializer = 'serializer_txt' }

serializer_txt = { }

alert_lioli = { logger = 'logger_file',
                testmode = true }


mqtt = { client_id_cache_min_size = 5}

binder = {
           { 
             when = { proto = "tcp", ports = "1883" },
             use  = { type = "mqtt" }
           },          
         }

ips = {
        rules = [[
          log mqtt (
            msg: "mqtt connect seen";

            mqtt_field: Msg.Connect;

            sid:3000000;
            )
          log mqtt (
            msg: "mqtt subscribe seen";

            mqtt_field: Msg.Subscribe;

            sid:3000001;
            )
          log mqtt (
            msg: "mqtt disconnect seen";

            mqtt_field: Msg.Disconnect;

            sid:3000002;
            )

        ]]
      }
